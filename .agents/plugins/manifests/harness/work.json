{
  "schema_version": 1,
  "plugin": "work-agents/work",
  "source_roots": [
    ".agents/work"
  ],
  "requires": {
    "marketplaces": [
      {
        "id": "work-agents",
        "repository": "tj-agents/work"
      },
      {
        "id": "base-agents",
        "repository": "tj-agents/core"
      }
    ],
    "plugins": [
      "work-agents/work",
      "base-agents/base",
      "base-agents/machine"
    ],
    "hooks": [],
    "permissions": {
      "claude_allow": [
        "Bash(python -B ${PLUGIN_ROOT}/skills/draft-comment/scripts/post_pending_review.py:*)",
        "PowerShell(python -B ${PLUGIN_ROOT}/skills/draft-comment/scripts/post_pending_review.py:*)"
      ],
      "codex_prefix_rules": [
        {
          "pattern": [
            [
              "python",
              "python.exe",
              "python3",
              "py"
            ],
            "-B",
            [
              "${PLUGIN_ROOT}/skills/draft-comment/scripts/post_pending_review.py"
            ]
          ],
          "justification": "draft-comment posts only a pending GitHub review after exact authorization; the helper rejects every submission field, checks for an existing pending review, and verifies the created review remains pending",
          "match": [
            [
              "python",
              "-B",
              "${PLUGIN_ROOT}/skills/draft-comment/scripts/post_pending_review.py"
            ]
          ],
          "not_match": [
            [
              "python",
              "${PLUGIN_ROOT}/skills/draft-comment/scripts/post_pending_review.py"
            ]
          ]
        }
      ]
    }
  }
}
